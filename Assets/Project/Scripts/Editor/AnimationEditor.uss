/* =========================================================
   Combat Animation Editor — USS Stylesheet
   Premium NLE-style dark theme with TwoPaneSplitView
   ========================================================= */

/* ─── ROOT ─── */
.root-container {
    flex-grow: 1;
    flex-direction: column;
    background-color: #1a1a2e;
}

/* ─── HEADER BAR ─── */
.header-bar {
    flex-direction: row;
    height: 44px;
    min-height: 44px;
    background-color: rgba(20, 20, 35, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: #2a2a45;
    padding-left: 12px;
    padding-right: 12px;
    align-items: center;
}

.header-character {
    flex-direction: row;
    align-items: center;
    width: 200px;
}

.header-character__icon {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #3a3a55;
    margin-right: 8px;
}

.header-character__name {
    font-size: 13px;
    color: #E8E8F0;
    -unity-font-style: bold;
}

.header-breadcrumb {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.header-breadcrumb__pill {
    background-color: #242438;
    border-radius: 14px;
    padding: 4px 16px;
    border-width: 1px;
    border-color: #2a2a45;
}

.header-breadcrumb__text {
    font-size: 11px;
    color: #8888AA;
}

.header-frame-counter {
    width: 160px;
    align-items: flex-end;
    justify-content: center;
}

.header-frame-counter__pill {
    background-color: rgba(0, 212, 255, 0.12);
    border-radius: 14px;
    padding: 4px 14px;
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.3);
}

.header-frame-counter__text {
    font-size: 12px;
    color: #00D4FF;
    -unity-font-style: bold;
}

/* ─── BODY (TwoPaneSplitView) ─── */
.body-container {
    flex-grow: 1;
}

/* ─── LEFT SIDEBAR ─── */
.sidebar {
    min-width: 180px;
    background-color: #1e1e30;
    border-right-width: 1px;
    border-right-color: #2a2a45;
    padding-top: 8px;
}

.sidebar-scroll {
    flex-grow: 1;
}

.sidebar-category {
    margin-bottom: 4px;
}

.sidebar-category__header {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    cursor: link;
}

.sidebar-category__header:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.sidebar-category__arrow {
    font-size: 9px;
    color: #555570;
    margin-right: 6px;
    width: 12px;
}

.sidebar-category__label {
    font-size: 12px;
    color: #8888AA;
    -unity-font-style: bold;
}

.sidebar-items {
    margin-left: 20px;
}

.sidebar-item {
    padding: 5px 12px;
    padding-left: 14px;
    border-left-width: 3px;
    border-left-color: transparent;
    cursor: link;
}

.sidebar-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.sidebar-item--active {
    background-color: rgba(0, 212, 255, 0.08);
    border-left-color: #00D4FF;
}

.sidebar-item__label {
    font-size: 11px;
    color: #8888AA;
}

.sidebar-item--active > .sidebar-item__label {
    color: #E8E8F0;
    -unity-font-style: bold;
}

.sidebar-subitem {
    padding-left: 26px;
    opacity: 0.8;
}

/* ─── CENTER AREA ─── */
.center-area {
    flex-grow: 1;
    flex-direction: column;
    min-width: 300px;
}

/* Preview Viewport */
.preview-viewport {
    height: 140px;
    min-height: 80px;
    background-color: #0d0d1a;
    border-radius: 8px;
    margin: 8px;
    border-width: 1px;
    border-color: #2a2a40;
    align-items: center;
    justify-content: center;
}

.preview-viewport__status {
    font-size: 11px;
    color: #555570;
    -unity-font-style: italic;
}

.preview-viewport__clip-name {
    font-size: 12px;
    color: #8888AA;
    margin-top: 4px;
}

/* Clip Selector Row */
.clip-selector-row {
    flex-direction: row;
    padding: 4px 12px;
    align-items: center;
}

.clip-selector-row > Label {
    width: 80px;
    font-size: 11px;
    color: #8888AA;
}

.clip-selector-row > ObjectField {
    flex-grow: 1;
}

/* ─── TIMELINE DASHBOARD ─── */
.timeline-dashboard {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 8px 8px 8px;
    background-color: #141420;
    border-radius: 8px;
    border-width: 1px;
    border-color: #2a2a40;
    min-height: 120px;
    overflow: hidden;
}

.timeline-canvas {
    flex-grow: 1;
    min-height: 80px;
}

/* Transport Bar */
.transport-bar {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 6px 12px;
    border-top-width: 1px;
    border-top-color: #2a2a40;
    background-color: #1a1a28;
}

.transport-btn {
    width: 32px;
    height: 26px;
    border-radius: 6px;
    background-color: #242438;
    border-width: 1px;
    border-color: #2a2a45;
    margin: 0 2px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: #8888AA;
    cursor: link;
}

.transport-btn:hover {
    background-color: #2e2e48;
    color: #E8E8F0;
}

.transport-btn--play {
    width: 36px;
    background-color: rgba(0, 212, 255, 0.15);
    border-color: rgba(0, 212, 255, 0.3);
    color: #00D4FF;
}

.transport-btn--play:hover {
    background-color: rgba(0, 212, 255, 0.25);
}

.transport-frame-label {
    font-size: 13px;
    color: #E8E8F0;
    -unity-font-style: bold;
    margin: 0 16px;
    min-width: 120px;
    -unity-text-align: middle-center;
}

/* ─── RIGHT PANEL ─── */
.property-panel {
    min-width: 260px;
    background-color: #1a1a2a;
    border-left-width: 1px;
    border-left-color: #2a2a45;
}

.property-scroll {
    flex-grow: 1;
    padding: 8px;
}

.component-card-list {
    position: relative;
}

/* ─── PROPERTY CARDS (Foldout) ─── */
.property-card {
    background-color: #242438;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2a2a45;
    margin-bottom: 8px;
    padding: 0;
    overflow: hidden;
}

.property-subcard {
    background-color: #20203a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #28284a;
    margin-bottom: 6px;
    margin-left: 4px;
    padding: 0;
    overflow: hidden;
}

.property-card__header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #2a2a45;
    background-color: rgba(255, 255, 255, 0.02);
    cursor: link;
}

.property-card__header:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.property-card__accent {
    width: 4px;
    height: 18px;
    border-radius: 2px;
    margin-right: 8px;
    flex-shrink: 0;
}

.property-card__drag-handle {
    width: 22px;
    margin-right: 6px;
    color: #5f5f86;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: link;
}

.property-card__drag-handle:hover {
    color: #b9b9d8;
}

.property-card__arrow {
    font-size: 10px;
    color: #555570;
    margin-right: 6px;
    width: 12px;
    -unity-text-align: middle-left;
}

.property-card__header-text {
    font-size: 12px;
    color: #E8E8F0;
    -unity-font-style: bold;
    flex-grow: 1;
}

.property-card__delete {
    font-size: 10px;
    color: #FF4444;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgba(255, 68, 68, 0.1);
    border-width: 1px;
    border-color: rgba(255, 68, 68, 0.2);
    flex-shrink: 0;
}

.property-card__delete:hover {
    background-color: rgba(255, 68, 68, 0.25);
}

.property-card__body {
    padding: 10px 12px;
}

.property-card__body > * {
    margin-bottom: 4px;
}

.property-card__placeholder {
    min-height: 46px;
    border-radius: 8px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.45);
    background-color: rgba(0, 212, 255, 0.08);
}

.property-card--dragging {
    opacity: 0.92;
    background-color: rgba(42, 42, 72, 0.96);
    border-color: rgba(0, 212, 255, 0.55);
}

/* Card field rows */
.card-field-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 3px;
}

.card-field-row > Label {
    width: 100px;
    min-width: 80px;
    font-size: 11px;
    color: #8888AA;
}

.card-field-row > IntegerField,
.card-field-row > FloatField,
.card-field-row > TextField,
.card-field-row > Toggle,
.card-field-row > EnumField,
.card-field-row > ObjectField,
.card-field-row > Vector2Field,
.card-field-row > Vector3Field {
    flex-grow: 1;
}

.card-separator {
    height: 1px;
    background-color: #2a2a45;
    margin: 6px 0;
}

.card-sub-header {
    font-size: 10px;
    color: #555570;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 2px;
}

/* ─── ADD COMPONENT BUTTON ─── */
.add-component-row {
    margin: 4px 0 12px 0;
}

.add-component-btn {
    height: 34px;
    border-radius: 8px;
    background-color: rgba(0, 212, 255, 0.08);
    border-width: 1px;
    border-color: rgba(0, 212, 255, 0.25);
    color: #00D4FF;
    font-size: 12px;
    -unity-font-style: bold;
    cursor: link;
}

.add-component-btn:hover {
    background-color: rgba(0, 212, 255, 0.18);
    border-color: rgba(0, 212, 255, 0.5);
}

.component-add-entry-btn {
    height: 26px;
    border-radius: 6px;
    background-color: rgba(68, 221, 102, 0.08);
    border-width: 1px;
    border-color: rgba(68, 221, 102, 0.2);
    color: #44DD66;
    font-size: 11px;
    -unity-font-style: bold;
    margin-top: 6px;
    cursor: link;
}

.component-add-entry-btn:hover {
    background-color: rgba(68, 221, 102, 0.18);
}

/* MinMax Slider readout */
.phase-readout {
    font-size: 11px;
    color: #E8E8F0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.phase-fields {
    flex-direction: row;
}

.phase-fields > IntegerField {
    flex-grow: 1;
    margin: 0 2px;
}

/* Placeholder / Empty State */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-state__text {
    font-size: 13px;
    color: #555570;
    -unity-text-align: middle-center;
}

/* ─── SPLIT VIEW DRAG HANDLE ─── */
.unity-two-pane-split-view__dragline-anchor {
    background-color: #2a2a45;
}

.unity-two-pane-split-view__dragline-anchor:hover {
    background-color: #00D4FF;
}
