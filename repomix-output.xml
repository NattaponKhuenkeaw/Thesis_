<file path="Assets/Project/Scripts/Behavior/Actions/NoticeExclamationAction.cs">
using System;
using Unity.Properties;
using UnityEngine;

using Unity.Behavior;

namespace Unity.Behavior
{
    /// <summary>
    /// Perform Action: Notice Exclamation — activates an "!" GameObject above the enemy
    /// prompting player detection, and plays a punch-scale pop animation.
    /// Returns Success after the display duration.
    /// </summary>
    [Serializable, GeneratePropertyBag]
    [NodeDescription(
        name: "Notice Exclamation",
        description: "Pops an exclamation mark above the enemy to signal player detection, then returns Success.",
        story: "[Agent] notices with exclamation mark",
        category: "Action/Enemy",
        id: "c1b2c3d4e5f60007aabbccddeeff0027")]
    public partial class NoticeExclamationAction : Unity.Behavior.Action
    {
        [SerializeReference] public BlackboardVariable<GameObject> Agent = new BlackboardVariable<GameObject>();
        
        [Tooltip("The '!' child GameObject or Prefab instance to activate. If null, searched by name 'ExclamationMark' on Agent.")]
        [SerializeReference] public BlackboardVariable<GameObject> ExclamationMark = new BlackboardVariable<GameObject>();
        
        [SerializeReference] public BlackboardVariable<GameObject> Target = new BlackboardVariable<GameObject>();

        [Tooltip("Total duration to show the '!' before hiding it.")]
        [SerializeReference] public BlackboardVariable<float> DisplayDuration = new BlackboardVariable<float>(0.7f);

        [Tooltip("If true, the exclamation mark faces the camera every frame.")]
        public bool UseBillboard = true;

        // Pop animation curve: goes 0 → 1.3 → 1.0 over 0..1 time
        private static readonly Keyframe[] PopKeys =
        {
            new Keyframe(0f,   0f,   0f, 10f),
            new Keyframe(0.35f, 1.3f, 0f, 0f),
            new Keyframe(0.6f,  1.0f, 0f, 0f),
            new Keyframe(1f,    1.0f, 0f, 0f)
        };
        private static AnimationCurve s_PopCurve;

        private GameObject m_Mark;
        private float m_Timer;
        private float m_PopDuration = 0.4f; // pop anim runs for this long

        protected override Status OnStart()
        {
            if (Agent.Value == null) return Status.Failure;

            // Resolve the exclamation mark GameObject
            if (ExclamationMark?.Value != null)
                m_Mark = ExclamationMark.Value;
            else
                m_Mark = FindChildByName(Agent.Value.transform, "ExclamationMark");

            if (m_Mark == null)
            {
                Debug.LogWarning($"[NoticeExclamation] No 'ExclamationMark' GameObject found for {Agent.Value.name}.");
                return Status.Success; // skip gracefully
            }

            if (s_PopCurve == null) s_PopCurve = new AnimationCurve(PopKeys);

            m_Mark.SetActive(true);
            m_Mark.transform.localScale = Vector3.zero;
            m_Timer = 0f;

            // Initial billboard alignment
            UpdateBillboard();

            // Face the player/target
            if (Target != null && Target.Value != null)
            {
                float dirX = Target.Value.transform.position.x - Agent.Value.transform.position.x;
                if (Mathf.Abs(dirX) > 0.01f)
                {
                    Vector3 scale = Agent.Value.transform.localScale;
                    scale.x = Mathf.Abs(scale.x) * Mathf.Sign(dirX);
                    Agent.Value.transform.localScale = scale;
                }
            }

            return Status.Running;
        }

        protected override Status OnUpdate()
        {
            if (m_Mark == null) return Status.Failure;
            
            m_Timer += Time.deltaTime;

            // Optional billboard
            UpdateBillboard();

            // Drive pop scale animation
            if (m_Timer <= m_PopDuration)
            {
                float t = m_Timer / m_PopDuration;
                float s = s_PopCurve.Evaluate(t);
                m_Mark.transform.localScale = new Vector3(s, s, 1f);
            }
            else
            {
                // Hold at full scale
                m_Mark.transform.localScale = Vector3.one;
            }

            if (m_Timer >= DisplayDuration.Value)
            {
                m_Mark.SetActive(false);
                return Status.Success;
            }

            return Status.Running;
        }

        private void UpdateBillboard()
        {
            if (UseBillboard && Camera.main != null && m_Mark != null)
            {
                // Simple billboard to match camera rotation
                m_Mark.transform.rotation = Camera.main.transform.rotation;
            }
        }

        protected override void OnEnd()
        {
            if (m_Mark != null) m_Mark.SetActive(false);
            m_Mark = null;
        }

        private static GameObject FindChildByName(Transform parent, string childName)
        {
            foreach (Transform child in parent)
            {
                if (child.name == childName) return child.gameObject;
                GameObject found = FindChildByName(child, childName);
                if (found != null) return found;
            }
            return null;
        }
    }
}
</file>

<file path="Assets/Project/Scripts/Behavior/Actions/PatrolAction.cs">
using System;
using Unity.Properties;
using UnityEngine;

using Unity.Behavior;
    /// <summary>
    /// Perform Action: Patrol — picks a random X position within ±PatrolRadius of the
    /// spawn X (Y stays fixed), walks to it, then returns Success.
    /// The graph loops this back to IdleAction to create the Idle ↔ Patrol cycle.
    /// </summary>
    [Serializable, GeneratePropertyBag]
    [NodeDescription(
        name: "Enemy Patrol",
        description: "Walks the Agent to a random X position near the spawn point, then returns Success.",
        story: "[Agent] patrols (radius [PatrolRadius])",
        category: "Action/Enemy",
        id: "c1b2c3d4e5f60003aabbccddeeff0023")]
    public partial class PatrolAction : Unity.Behavior.Action
    {
        [SerializeReference] public BlackboardVariable<GameObject> Agent;
        [SerializeReference] public BlackboardVariable<GameObject> Target;
        [SerializeReference] public BlackboardVariable<bool> IsTakingDamage;
        [SerializeReference] public BlackboardVariable<float> PatrolRadius  = new BlackboardVariable<float>(4f);
        [SerializeReference] public BlackboardVariable<float> MoveSpeed     = new BlackboardVariable<float>(2f);
        [SerializeReference] public BlackboardVariable<float> ArrivalThreshold = new BlackboardVariable<float>(0.15f);

        private EnemyController m_Controller;
        private AnimationHandler_Enemy m_AnimHandler;
        private Vector2 m_SpawnPosition;
        private Vector2 m_TargetPosition;
        private bool m_Initialized;

        protected override Status OnStart()
        {
            if (Agent.Value == null) return Status.Failure;

            // Fail if there is a target or taking damage
            if ((Target != null && Target.Value != null) || (IsTakingDamage != null && IsTakingDamage.Value))
            {
                return Status.Failure;
            }

            m_Controller = Agent.Value.GetComponent<EnemyController>();
            m_AnimHandler = Agent.Value.GetComponentInChildren<AnimationHandler_Enemy>();

            if (!m_Initialized)
            {
                m_SpawnPosition = Agent.Value.transform.position;
                m_Initialized = true;
            }

            // Pick random X within ±PatrolRadius of spawn X, keep current Y
            float randomX = m_SpawnPosition.x + UnityEngine.Random.Range(-PatrolRadius.Value, PatrolRadius.Value);
            m_TargetPosition = new Vector2(randomX, Agent.Value.transform.position.y);

            m_AnimHandler?.SetSpeed(MoveSpeed.Value);
            return Status.Running;
        }

        protected override Status OnUpdate()
        {
            if (Agent.Value == null) return Status.Failure;

            // Fail if there is a target or taking damage
            if ((Target != null && Target.Value != null) || (IsTakingDamage != null && IsTakingDamage.Value))
            {
                m_AnimHandler?.SetSpeed(0f);
                return Status.Failure;
            }

            Transform t = Agent.Value.transform;
            Vector3 pos = t.position;
            float dist = Mathf.Abs(pos.x - m_TargetPosition.x);

            if (dist <= ArrivalThreshold.Value)
            {
                m_AnimHandler?.SetSpeed(0f);
                return Status.Success;
            }

            // Move horizontally
            float step = MoveSpeed.Value * Time.deltaTime;
            float newX = Mathf.MoveTowards(pos.x, m_TargetPosition.x, step);
            t.position = new Vector3(newX, pos.y, pos.z);

            // Flip sprite to face direction
            float dirX = m_TargetPosition.x - pos.x;
            if (Mathf.Abs(dirX) > 0.01f)
            {
                float targetRotY = dirX > 0f ? 0f : 180f;
                t.eulerAngles = new Vector3(t.eulerAngles.x, targetRotY, t.eulerAngles.z);
            }

            m_AnimHandler?.SetSpeed(MoveSpeed.Value);
            return Status.Running;
        }

        protected override void OnEnd()
        {
            m_AnimHandler?.SetSpeed(0f);
            m_Controller = null;
            m_AnimHandler = null;
        }
    }
</file>

