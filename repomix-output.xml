				#endif
			};

		};
		this.easeInternal = ()=>{
			newVect = easeMethod();
			val = newVect.x;
			#if UNITY_3_5 || UNITY_4_0 || UNITY_4_0_1 || UNITY_4_1 || UNITY_4_2
