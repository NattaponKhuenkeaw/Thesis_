        }

        if (requiredCounters != null)
        {
            for (int i = 0; i < requiredCounters.Count; i++)
            {
                RuntimeCounterRequirement requirement = requiredCounters[i];
                if (requirement != null && !requirement.Matches(runtimeState))
                {
                    return false;
                }
            }
        }

        return true;
    }
