<file path="Assets/Project/Scripts/Combat/GameAudioManager.cs">
using UnityEngine;
using System.Collections;
using System.Collections.Generic;
using Project.Core;

public class GameAudioManager : MonoBehaviour
{
    public static GameAudioManager Instance { get; private set; }

    [Header("Pool Settings")]
    public int initialPoolSize = 10;
    
    private Queue<AudioSource> sourcePool = new Queue<AudioSource>();
    private AudioSource voiceSource; // Single instance to mutually exclude lines

    private void Awake()
    {
        string sourceSceneName = gameObject.scene.name;
        RootPersistentManager rootManager = GetComponentInParent<RootPersistentManager>();
        if (rootManager != null && rootManager.IsDuplicate)
        {
            enabled = false;
            return;
        }

        if (Instance != null && Instance != this)
        {
            Debug.Log($"[GameAudioManager] Duplicate audio manager '{gameObject.name}' loaded from scene '{sourceSceneName}'. Destroying duplicate.");
            Destroy(gameObject);
            return;
        }

        Instance = this;

        if (rootManager == null)
        {
            transform.SetParent(null);
            DontDestroyOnLoad(gameObject);
            Debug.Log($"[GameAudioManager] Standalone audio manager initialized from scene '{sourceSceneName}'.");
        }
        else
        {
            Debug.Log($"[GameAudioManager] Audio manager registered under persistent root '{rootManager.gameObject.name}'.");
        }

        InitializePool();
    }

    private void OnDestroy()
    {
        if (Instance == this)
        {
            Instance = null;
        }
    }

    private void InitializePool()
    {
        for (int i = 0; i < initialPoolSize; i++)
        {
            sourcePool.Enqueue(CreateNewSource("PooledAudioSource"));
        }

        voiceSource = CreateNewSource("VoiceAudioSource");
    }

    private AudioSource CreateNewSource(string namePrefix)
    {
        GameObject go = new GameObject($"{namePrefix}_{System.Guid.NewGuid().ToString().Substring(0, 4)}");
        go.transform.SetParent(transform);
        AudioSource src = go.AddComponent<AudioSource>();
        src.playOnAwake = false;
        return src;
    }

    private AudioSource GetSource()
    {
        if (sourcePool.Count > 0)
        {
            return sourcePool.Dequeue();
        }
        return CreateNewSource("PooledAudioSource");
    }

    private void ReturnSource(AudioSource src)
    {
        src.Stop();
        src.clip = null;
        src.ignoreListenerPause = false; // Reset to default
        sourcePool.Enqueue(src);
    }

    public void PlayTimelineAudio(AudioEntry entry)
    {
        if (entry.clip == null)
        {
            Debug.LogWarning($"GameAudioManager: AudioEntry '{entry.label}' has no AudioClip assigned!", this);
            return;
        }

        if (entry.channel == AudioChannel.Voice)
        {
            // Override previous voice
            voiceSource.Stop();
            voiceSource.clip = entry.clip;
            voiceSource.volume = entry.volume;
            voiceSource.pitch = entry.pitchVariation; // If we want to vary pitch
            voiceSource.ignoreListenerPause = false;
            voiceSource.Play();
        }
        else
        {
            // Action, Hit, etc.
            AudioSource src = GetSource();
            src.clip = entry.clip;
            src.volume = entry.volume;
            src.pitch = entry.pitchVariation;
            src.ignoreListenerPause = false;
            src.Play();
            StartCoroutine(ReturnSourceRoutine(src, entry.clip.length / Mathf.Max(0.01f, src.pitch)));
        }
    }

    public void PlayHitSFX(AudioClip clip, float volume = 1f, float pitch = 1f)
    {
        if (clip == null) return;

        AudioSource src = GetSource();
        src.clip = clip;
        src.volume = volume;
        src.pitch = pitch;
        src.ignoreListenerPause = false;
        src.Play();
        StartCoroutine(ReturnSourceRoutine(src, clip.length / Mathf.Max(0.01f, src.pitch)));
    }

    public void PlayUltimateActivation(UltimateAction ultimate)
    {
        if (ultimate == null) return;
        PlayUltimateActivation(ultimate.activationVoice, ultimate.activationSFX, ultimate.voiceDelay);
    }

    public void PlayUltimateActivation(AudioClip activationVoice, AudioClip activationSFX, float voiceDelay)
    {
        if (activationVoice != null)
        {
            StartCoroutine(PlayUnscaledDelayed(activationVoice, voiceDelay, true));
        }

        if (activationSFX != null)
        {
            StartCoroutine(PlayUnscaledDelayed(activationSFX, 0f, false));
        }
    }

    private IEnumerator PlayUnscaledDelayed(AudioClip clip, float delayRealtime, bool isVoice)
    {
        if (delayRealtime > 0f)
        {
            yield return new WaitForSecondsRealtime(delayRealtime);
        }

        if (isVoice)
        {
            voiceSource.Stop();
            voiceSource.clip = clip;
            voiceSource.volume = 1f;
            voiceSource.pitch = 1f;
            voiceSource.ignoreListenerPause = true; // PLAY THROUGH FREEZE
            voiceSource.Play();
            
            // Note: voiceSource doesn't need to be returned to pool
        }
        else
        {
            AudioSource src = GetSource();
            src.clip = clip;
            src.volume = 1f;
            src.pitch = 1f;
            src.ignoreListenerPause = true; // PLAY THROUGH FREEZE
            src.Play();

            // Can't use normal ReturnSourceRoutine since time scale is 0. 
            // Return after unscaled realtime.
            StartCoroutine(ReturnSourceUnscaledRoutine(src, clip.length));
        }
    }

    private IEnumerator ReturnSourceRoutine(AudioSource src, float delay)
    {
        yield return new WaitForSeconds(delay);
        ReturnSource(src);
    }

    private IEnumerator ReturnSourceUnscaledRoutine(AudioSource src, float delay)
    {
        yield return new WaitForSecondsRealtime(delay);
        ReturnSource(src);
    }
}
</file>

<file path="Assets/Project/Scripts/Combat/GameFreezeManager.cs">
using System;
using System.Collections;
using CombatCore;
using UnityEngine;
using Project.Core;

/// <summary>
/// Centralized manager for game-wide freezes (hitstop/hitfreeze).
/// Uses Time.timeScale to ensure all systems (physics, coroutines, UI, etc.) 
/// are synchronized during a freeze.
/// </summary>
public class GameFreezeManager : MonoBehaviour
{
    public readonly struct FreezeToken
    {
        public FreezeToken(int id)
        {
            Id = id;
        }

        public int Id { get; }
        public bool IsValid => Id != 0;
    }

    public static GameFreezeManager Instance { get; private set; }

    private Coroutine freezeCoroutine;
    private Coroutine slowMotionCoroutine;
    private int currentFreezeFramesRemaining;
    private int nextFreezeTokenId = 1;
    private int activeScopedFreezeTokenId;
    private float defaultFixedDeltaTime;

    public bool IsTimeFrozen => Time.timeScale <= 0f;
    public bool HasActiveScopedFreeze => activeScopedFreezeTokenId != 0;

    private void Awake()
    {
        string sourceSceneName = gameObject.scene.name;
        RootPersistentManager rootManager = GetComponentInParent<RootPersistentManager>();
        if (rootManager != null && rootManager.IsDuplicate)
        {
            enabled = false;
            return;
        }

        if (Instance != null && Instance != this)
        {
            Debug.Log($"[GameFreezeManager] Duplicate freeze manager '{gameObject.name}' loaded from scene '{sourceSceneName}'. Destroying duplicate.");
            Destroy(gameObject);
            return;
        }

        Instance = this;
        defaultFixedDeltaTime = Time.fixedDeltaTime;

        if (rootManager == null)
        {
            transform.SetParent(null);
            DontDestroyOnLoad(gameObject);
            Debug.Log($"[GameFreezeManager] Standalone freeze manager initialized from scene '{sourceSceneName}'.");
        }
        else
        {
            Debug.Log($"[GameFreezeManager] Freeze manager registered under persistent root '{rootManager.gameObject.name}'.");
        }
    }

    private void OnDestroy()
    {
        if (Instance == this)
        {
            // Ensure timeScale is restored if the manager is destroyed
            Time.timeScale = 1f;
            Time.fixedDeltaTime = defaultFixedDeltaTime > 0f ? defaultFixedDeltaTime : 0.02f;
            Instance = null;
        }
    }

    /// <summary>
    /// Freezes the game for a specified number of frames.
    /// Frames are translated to real-time seconds based on LOGIC_FPS.
    /// </summary>
    public void FreezeFrame(int frames)
    {
        if (frames <= 0) return;
        if (HasActiveScopedFreeze) return;

        StopSlowMotion(false);

        // If a new freeze is requested, we take the maximum duration
        if (frames > currentFreezeFramesRemaining)
        {
            currentFreezeFramesRemaining = frames;
            
            if (freezeCoroutine != null)
            {
                StopCoroutine(freezeCoroutine);
            }
            
            float durationSeconds = frames / FrameDataConstants.LOGIC_FPS;
            freezeCoroutine = StartCoroutine(FreezeRoutine(durationSeconds));
        }
    }

    public FreezeToken BeginScopedFreeze()
    {
        currentFreezeFramesRemaining = 0;
        StopSlowMotion(false);

        if (freezeCoroutine != null)
        {
            StopCoroutine(freezeCoroutine);
            freezeCoroutine = null;
        }

        activeScopedFreezeTokenId = nextFreezeTokenId++;
        Time.timeScale = 0f;
        return new FreezeToken(activeScopedFreezeTokenId);
    }

    public bool EndScopedFreeze(FreezeToken token)
    {
        if (!OwnsScopedFreeze(token))
        {
            return false;
        }

        RestoreTime();
        return true;
    }

    public bool OwnsScopedFreeze(FreezeToken token)
    {
        return token.IsValid && activeScopedFreezeTokenId == token.Id;
    }

    /// <summary>
    /// Special freeze for Ultimate activations with a fixed duration.
    /// Typically longer and might trigger a callback when finished.
    /// </summary>
    public void UltimateFreeze(int frames, Action onFreezeEnd = null)
    {
        if (HasActiveScopedFreeze)
        {
            return;
        }

        StopSlowMotion(false);

        currentFreezeFramesRemaining = frames;

        if (freezeCoroutine != null)
        {
            StopCoroutine(freezeCoroutine);
        }

        float durationSeconds = frames / FrameDataConstants.LOGIC_FPS;
        freezeCoroutine = StartCoroutine(FreezeRoutine(durationSeconds, onFreezeEnd));
    }

    private IEnumerator FreezeRoutine(float seconds, Action onComplete = null)
    {
        Time.timeScale = 0f;

        // Use WaitForSecondsRealtime because Time.timeScale is 0
        yield return new WaitForSecondsRealtime(seconds);

        Time.timeScale = 1f;
        Time.fixedDeltaTime = defaultFixedDeltaTime;
        currentFreezeFramesRemaining = 0;
        freezeCoroutine = null;
        
        onComplete?.Invoke();
    }

    public void PlaySlowMotion(float timeScale, float duration, float delaySeconds = 0f)
    {
        if (duration <= 0f || timeScale <= 0f || timeScale >= 1f)
        {
            return;
        }

        if (slowMotionCoroutine != null)
        {
            StopCoroutine(slowMotionCoroutine);
        }

        slowMotionCoroutine = StartCoroutine(SlowMotionRoutine(
            Mathf.Clamp(timeScale, 0.01f, 0.99f),
            duration,
            Mathf.Max(0f, delaySeconds)));
    }

    private IEnumerator SlowMotionRoutine(float timeScale, float duration, float delaySeconds)
    {
        if (delaySeconds > 0f)
        {
            yield return new WaitForSecondsRealtime(delaySeconds);
        }

        if (HasActiveScopedFreeze || IsTimeFrozen)
        {
            slowMotionCoroutine = null;
            yield break;
        }

        Time.timeScale = timeScale;
        Time.fixedDeltaTime = defaultFixedDeltaTime * timeScale;

        yield return new WaitForSecondsRealtime(duration);

        if (!HasActiveScopedFreeze && !IsTimeFrozen)
        {
            Time.timeScale = 1f;
            Time.fixedDeltaTime = defaultFixedDeltaTime;
        }

        slowMotionCoroutine = null;
    }

    /// <summary>
    /// Forcefully restores time scale. Use with caution.
    /// </summary>
    public void RestoreTime()
    {
        if (freezeCoroutine != null)
        {
            StopCoroutine(freezeCoroutine);
            freezeCoroutine = null;
        }

        StopSlowMotion(false);
        Time.timeScale = 1f;
        Time.fixedDeltaTime = defaultFixedDeltaTime;
        currentFreezeFramesRemaining = 0;
        activeScopedFreezeTokenId = 0;
    }

    private void StopSlowMotion(bool restoreTimeScale)
    {
        if (slowMotionCoroutine != null)
        {
            StopCoroutine(slowMotionCoroutine);
            slowMotionCoroutine = null;
        }

        if (restoreTimeScale)
        {
            Time.timeScale = 1f;
            Time.fixedDeltaTime = defaultFixedDeltaTime;
        }
    }
}
</file>

<file path="Assets/Project/Scripts/Combat/GameImpulseController.cs">
using System.Collections;
using CombatCore;
using Unity.Cinemachine;
using UnityEngine;

[System.Serializable]
public class SlowMotionSettings
{
    public bool enabled;

    [Range(0.01f, 1f)]
    public float timeScale = 0.35f;

    public float duration = 0.08f;
    public float delaySeconds;

    public float GetTotalDurationSeconds()
    {
        if (!enabled)
        {
            return 0f;
        }

        return Mathf.Max(0f, delaySeconds) + Mathf.Max(0f, duration);
    }
}

[System.Serializable]
public class GameImpulseRequest
{
    public float startStrength = 0.4f;
    public float endStrength = 0.1f;
    public float duration = 0.16f;
    public float pulseInterval = 0.03f;
    public SlowMotionSettings slowMotion = new SlowMotionSettings();

    public float GetTotalDurationSeconds()
    {
        return Mathf.Max(0f, duration) + (slowMotion != null ? slowMotion.GetTotalDurationSeconds() : 0f);
    }

    public static GameImpulseRequest CreateImpact(float startStrength, float endStrength, float duration, float pulseInterval)
    {
        return new GameImpulseRequest
        {
            startStrength = startStrength,
            endStrength = endStrength,
            duration = duration,
            pulseInterval = pulseInterval,
            slowMotion = new SlowMotionSettings()
        };
    }

    public static GameImpulseRequest CreateActionEventDefault()
    {
        return new GameImpulseRequest
        {
            startStrength = 0.4f,
            endStrength = 0.08f,
            duration = 0.14f,
            pulseInterval = 0.025f,
            slowMotion = new SlowMotionSettings
            {
                enabled = false,
                timeScale = 0.35f,
                duration = 0.08f,
                delaySeconds = 0f
            }
        };
    }
}

public class GameImpulseController : MonoBehaviour
{
    [System.Serializable]
    private class ImpactImpulseProfile
    {
        public DamageImpactTier tier = DamageImpactTier.Low;
        public GameImpulseRequest request = GameImpulseRequest.CreateImpact(0.2f, 0.05f, 0.1f, 0.025f);
    }

    private static GameImpulseController instance;

    public static GameImpulseController Instance
    {
        get
        {
            if (instance == null)
            {
                instance = FindFirstObjectByType<GameImpulseController>();
                if (instance == null)
                {
                    GameObject go = new GameObject(nameof(GameImpulseController));
                    instance = go.AddComponent<GameImpulseController>();
                }
            }

            return instance;
        }
    }

    [Header("Fallback")]
    [SerializeField] private CinemachineImpulseSource fallbackImpulseSource;
    [SerializeField, Range(0f, 1f)] private float outputStrengthMultiplier = 0.2f;

    [Header("Impact Profiles")]
    [SerializeField] private ImpactImpulseProfile lowImpact = new ImpactImpulseProfile
    {
        tier = DamageImpactTier.Low,
        request = new GameImpulseRequest
        {
            startStrength = 0.15f,
            endStrength = 0.03f,
            duration = 0.08f,
            pulseInterval = 0.025f,
            slowMotion = new SlowMotionSettings()
        }
    };

    [SerializeField] private ImpactImpulseProfile mediumImpact = new ImpactImpulseProfile
    {
        tier = DamageImpactTier.Medium,
        request = new GameImpulseRequest
        {
            startStrength = 0.4f,
            endStrength = 0.08f,
            duration = 0.12f,
            pulseInterval = 0.025f,
            slowMotion = new SlowMotionSettings()
        }
    };

    [SerializeField] private ImpactImpulseProfile heavyImpact = new ImpactImpulseProfile
    {
        tier = DamageImpactTier.Heavy,
        request = new GameImpulseRequest
        {
            startStrength = 0.65f,
            endStrength = 0.12f,
            duration = 0.16f,
            pulseInterval = 0.02f,
            slowMotion = new SlowMotionSettings()
        }
    };

    [SerializeField] private ImpactImpulseProfile ultimateImpact = new ImpactImpulseProfile
    {
        tier = DamageImpactTier.Ultimate,
        request = new GameImpulseRequest
        {
            startStrength = 1f,
            endStrength = 0.2f,
            duration = 0.22f,
            pulseInterval = 0.02f,
            slowMotion = new SlowMotionSettings()
        }
    };

    private void Awake()
    {
        if (instance == null)
        {
            instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else if (instance != this)
        {
            Destroy(gameObject);
            return;
        }

        if (fallbackImpulseSource == null)
        {
            fallbackImpulseSource = FindFirstObjectByType<CinemachineImpulseSource>();
        }
    }

    private void OnDestroy()
    {
        if (instance == this)
        {
            instance = null;
        }
    }

    public void Play(GameImpulseRequest request)
    {
        if (request == null)
        {
            return;
        }

        StartCoroutine(PlayImpulseRoutine(request));
    }

    public void PlayOneShot(float strength)
    {
        EmitImpulse(strength * outputStrengthMultiplier);
    }

    public void PlayImpact(DamageImpactTier tier)
    {
        Play(GetImpactRequest(tier));
    }

    private IEnumerator PlayImpulseRoutine(GameImpulseRequest request)
    {
        float pulseDuration = Mathf.Max(0f, request.duration);
        float pulseInterval = Mathf.Max(0.01f, request.pulseInterval);
        float strengthMultiplier = Mathf.Max(0f, outputStrengthMultiplier);

        if (pulseDuration <= 0f)
        {
            EmitImpulse(Mathf.Max(request.startStrength, request.endStrength) * strengthMultiplier);
        }
        else
        {
            float elapsed = 0f;
            while (elapsed < pulseDuration)
            {
                float normalized = pulseDuration <= 0f ? 1f : Mathf.Clamp01(elapsed / pulseDuration);
                float strength = Mathf.Lerp(request.startStrength, request.endStrength, normalized) * strengthMultiplier;
                EmitImpulse(strength);

                yield return new WaitForSecondsRealtime(pulseInterval);
                elapsed += pulseInterval;
            }

            EmitImpulse(request.endStrength * strengthMultiplier);
        }

        if (request.slowMotion != null
            && request.slowMotion.enabled
            && GameFreezeManager.Instance != null)
        {
            GameFreezeManager.Instance.PlaySlowMotion(
                request.slowMotion.timeScale,
                request.slowMotion.duration,
                request.slowMotion.delaySeconds);
        }
    }

    private void EmitImpulse(float strength)
    {
        if (strength <= 0f)
        {
            return;
        }

        if (CameraManager.instance != null)
        {
            CameraManager.instance.EmitImpulse(strength);
            return;
        }

        if (fallbackImpulseSource == null)
        {
            fallbackImpulseSource = FindFirstObjectByType<CinemachineImpulseSource>();
        }

        if (fallbackImpulseSource != null)
        {
            fallbackImpulseSource.GenerateImpulse(strength);
        }
    }

    private GameImpulseRequest GetImpactRequest(DamageImpactTier tier)
    {
        return tier switch
        {
            DamageImpactTier.Medium => mediumImpact.request,
            DamageImpactTier.Heavy => heavyImpact.request,
            DamageImpactTier.Ultimate => ultimateImpact.request,
            _ => lowImpact.request
        };
    }
}
