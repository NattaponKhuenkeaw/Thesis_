                            RecordUndo("Create Grab Success Next");
                            node.onGrabSuccessNode = new ComboNode { stepData = new AttackStepData { stepName = "Grab Followup" } };
                            MarkDirtyAndRebuild();
                        }) { text = "+ Create Target" };
                        grabNextRow.Add(createNextBtn);
