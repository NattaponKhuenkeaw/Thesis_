            LeanTest.expect(rotateRepeat == 3, "ROTATE REPEAT", "expected 3 times received " + rotateRepeat + " times");
            LeanTest.expect(cube3 == null, "DESTROY ON COMPLETE", "cube3:" + cube3);
        }

