<file path="Assets/Project/Scripts/TeamBuilder/UI/ArtifactGridItemUI.cs">
using System;
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using TMPro;
using Project.InventorySystem.Items;
using Project.UI;

namespace Project.TeamBuilder.UI
{
    /// <summary>
    /// A draggable artifact cell in the Artifact Grid Inventory.
    /// Implements Unity's drag interfaces to create a floating ghost during drag.
    /// Also supports click to open the preview panel.
    /// </summary>
    [RequireComponent(typeof(CanvasGroup))]
    public class ArtifactGridItemUI : MonoBehaviour, IBeginDragHandler, IDragHandler, IEndDragHandler, IPointerClickHandler
    {
        // =========================================================
        // UI References
        // =========================================================
        [Header("UI References")]
        [SerializeField] private Image iconImage;
        [SerializeField] private Image frameImage;
        [SerializeField] private TMP_Text nameText;
        [SerializeField] private GameObject equippedBadge; // Visual indicator when equipped

        [Header("Visual States")]
        [SerializeField] private Color normalFrameColor = new Color(0.8f, 0.7f, 0.4f, 1f);
        [SerializeField] private Color equippedFrameColor = new Color(0.3f, 0.3f, 0.3f, 0.5f);
        [SerializeField] private float equippedAlpha = 0.4f;

        // =========================================================
        // Runtime State
        // =========================================================
        private Artifact artifactData;
        private CanvasGroup canvasGroup;
        private Transform dragGhost;
        private Canvas rootCanvas;
        private bool isEquipped = false;

        // Event for preview
        public event Action<Artifact> OnClicked;

        // =========================================================
        // Properties
        // =========================================================
        public Artifact ArtifactData => artifactData;

        // =========================================================
        // Initialization
        // =========================================================
        public void Init(Artifact artifact, Canvas canvas, bool alreadyEquipped = false)
        {
            artifactData = artifact;
            rootCanvas = canvas;
            canvasGroup = GetComponent<CanvasGroup>();

            if (artifact != null)
            {
                if (iconImage != null && artifact.icon != null)
                    iconImage.sprite = artifact.icon;

                if (nameText != null)
                    nameText.text = artifact.itemName;
            }

            SetEquippedState(alreadyEquipped);
        }

        /// <summary>
        /// Dims/undims the cell based on whether the artifact is equipped on any team slot.
        /// </summary>
        public void SetEquippedState(bool equipped)
        {
            isEquipped = equipped;
            canvasGroup = canvasGroup != null ? canvasGroup : GetComponent<CanvasGroup>();

            if (equipped)
            {
                canvasGroup.alpha = equippedAlpha;
                if (frameImage != null) frameImage.color = equippedFrameColor;
                if (equippedBadge != null) equippedBadge.SetActive(true);
            }
            else
            {
                canvasGroup.alpha = 1f;
                if (frameImage != null) frameImage.color = normalFrameColor;
                if (equippedBadge != null) equippedBadge.SetActive(false);
            }
        }

        // =========================================================
        // Click Handler (Preview)
        // =========================================================
        public void OnPointerClick(PointerEventData eventData)
        {
            if (eventData.button == PointerEventData.InputButton.Left)
            {
                OnClicked?.Invoke(artifactData);
            }
        }

        // =========================================================
        // Drag Handlers
        // =========================================================
        public void OnBeginDrag(PointerEventData eventData)
        {
            if (artifactData == null) return;

            if (rootCanvas == null)
            {
                rootCanvas = GetComponentInParent<Canvas>()?.rootCanvas;
            }

            if (rootCanvas == null)
            {
                Debug.LogWarning("ArtifactGridItemUI: Cannot drag because no root Canvas was found.");
                return;
            }

            Sprite dragSprite = (iconImage != null) ? iconImage.sprite : null;
            dragGhost = UIDragGhostHelper.CreateGhost(rootCanvas, dragSprite, new Vector2(60f, 60f), 0.85f, "ArtifactDragGhost");

            // Make original semi-transparent during drag
            if (canvasGroup == null) canvasGroup = GetComponent<CanvasGroup>();
            if (canvasGroup != null)
            {
                canvasGroup.alpha = 0.5f;
                canvasGroup.blocksRaycasts = false;
            }
        }

        public void OnDrag(PointerEventData eventData)
        {
            if (dragGhost == null) return;
            UIDragGhostHelper.UpdatePosition(dragGhost, rootCanvas, eventData.position);
        }

        public void OnEndDrag(PointerEventData eventData)
        {
            UIDragGhostHelper.DestroyGhost(ref dragGhost);

            // Restore original appearance based on equipped state
            if (canvasGroup == null) canvasGroup = GetComponent<CanvasGroup>();
            if (canvasGroup != null)
            {
                if (!isEquipped)
                {
                    canvasGroup.alpha = 1f;
                }
                else
                {
                    canvasGroup.alpha = equippedAlpha;
                }
                canvasGroup.blocksRaycasts = true;
            }
        }
    }
}
</file>

<file path="Assets/Project/Scripts/TeamBuilder/UI/ArtifactGridPanel.cs">
using System.Collections.Generic;
using UnityEngine;
using Project.InventorySystem.Items;
using System;

namespace Project.TeamBuilder.UI
{
    /// <summary>
    /// Grid panel that displays all owned artifacts from the player's inventory.
    /// Spawns ArtifactGridItemUI cells and dims artifacts already assigned to team slots.
    /// </summary>
    public class ArtifactGridPanel : MonoBehaviour
    {
        // =========================================================
        // References
        // =========================================================
        [Header("Grid Setup")]
        [SerializeField] private Transform gridParent;
        [SerializeField] private GameObject gridItemPrefab;

        [Header("Dependencies")]
        [SerializeField] private Canvas rootCanvas;

        // =========================================================
        // Runtime State
        // =========================================================
        private List<ArtifactGridItemUI> spawnedItems = new List<ArtifactGridItemUI>();
        private TeamBuilderUI parentBuilder;

        public event Action<Artifact> OnArtifactClicked;

        // =========================================================
        // Initialization
        // =========================================================
        public void Init(TeamBuilderUI builder, Canvas canvas)
        {
            parentBuilder = builder;
            rootCanvas = canvas;
        }

        // =========================================================
        // Public Methods
        // =========================================================

        /// <summary>
        /// Populates the grid with the given list of Artifacts.
        /// Artifacts already equipped in the team will be dimmed.
        /// </summary>
        public void PopulateGrid(List<Artifact> artifacts)
        {
            ClearGrid();

            if (artifacts == null) return;

            foreach (var artifact in artifacts)
            {
                if (artifact == null) continue;

                GameObject cellObj = Instantiate(gridItemPrefab, gridParent);
                ArtifactGridItemUI cellUI = cellObj.GetComponent<ArtifactGridItemUI>();

                if (cellUI != null)
                {
                    bool isEquipped = (parentBuilder != null) && parentBuilder.IsArtifactEquippedOnTeam(artifact);
                    cellUI.Init(artifact, rootCanvas, isEquipped);
                    cellUI.OnClicked += HandleArtifactClicked;
                    spawnedItems.Add(cellUI);
                }
            }
        }

        /// <summary>
        /// Refreshes the equipped state of all existing grid items without respawning.
        /// </summary>
        public void RefreshEquippedStates()
        {
            foreach (var item in spawnedItems)
            {
                if (item == null || item.ArtifactData == null) continue;
                bool isEquipped = (parentBuilder != null) && parentBuilder.IsArtifactEquippedOnTeam(item.ArtifactData);
                item.SetEquippedState(isEquipped);
            }
        }

        /// <summary>
        /// Clears all spawned grid items.
        /// </summary>
        public void ClearGrid()
        {
            foreach (var item in spawnedItems)
            {
                if (item != null)
                {
                    item.OnClicked -= HandleArtifactClicked;
                    Destroy(item.gameObject);
                }
            }
            spawnedItems.Clear();
        }

        private void HandleArtifactClicked(Artifact artifact)
        {
            OnArtifactClicked?.Invoke(artifact);
        }
    }
}
</file>

<file path="Assets/Project/Scripts/TeamBuilder/UI/ArtifactPreviewPanel.cs">
using UnityEngine;
using UnityEngine.UI;
using UnityEngine.EventSystems;
using TMPro;
using Project.InventorySystem.Items;

namespace Project.TeamBuilder.UI
{
    /// <summary>
    /// Detail panel for inspecting an artifact. Overlays the screen and can be dismissed
    /// by clicking outside its bounds.
    /// </summary>
    [RequireComponent(typeof(RectTransform))]
    public class ArtifactPreviewPanel : MonoBehaviour
    {
        [Header("UI References")]
        [SerializeField] private Image artifactIcon;
        [SerializeField] private TMP_Text artifactNameText;
        [SerializeField] private GameObject statItemPrefab;
        [SerializeField] private Transform statItemContainer;
        [SerializeField] private TMP_Text descriptionText;
        [SerializeField] private TMP_Text loreText; // Optional lore/flavor text

        // =========================================================
        // Runtime State
        // =========================================================
        private RectTransform panelRect;
        private Artifact currentArtifact;
        private bool isOpen;
        private int openedFrame = -1;

        public bool IsOpen => isOpen;

        private void Awake()
        {
            panelRect = GetComponent<RectTransform>();
            ResolveMissingReferences();
            gameObject.SetActive(false);
            isOpen = false;
        }

        private void Update()
        {
            if (!isOpen) return;
            if (Time.frameCount == openedFrame) return;

            // Dismiss when clicking outside the panel
            if (UnityEngine.InputSystem.Pointer.current != null && UnityEngine.InputSystem.Pointer.current.press.wasPressedThisFrame)
            {
                if (!RectTransformUtility.RectangleContainsScreenPoint(panelRect, UnityEngine.InputSystem.Pointer.current.position.ReadValue(), null))
                {
                    Close();
                }
            }
        }

        public void Open(Artifact artifact)
        {
            if (artifact == null) return;

            currentArtifact = artifact;
            gameObject.SetActive(true);
            isOpen = true;
            openedFrame = Time.frameCount;
            ResolveMissingReferences();
            PopulateData();

            // Move to front of hierarchy so it renders on top
            transform.SetAsLastSibling();
        }

        public void Close()
        {
            if (!isOpen) return;

            gameObject.SetActive(false);
            isOpen = false;
            currentArtifact = null;
        }

        private void ResolveMissingReferences()
        {
            TMP_Text[] texts = GetComponentsInChildren<TMP_Text>(true);
            Image[] images = GetComponentsInChildren<Image>(true);

            artifactNameText ??= FindTextByName(texts, "Name", "Title", "ArtifactName");
            descriptionText ??= FindTextByName(texts, "Description", "Passive", "Effect", "Info");
            loreText ??= FindTextByName(texts, "Lore", "Flavor");
            artifactIcon ??= FindImageByName(images, "Icon", "ArtifactIcon");

            if (statItemContainer == null)
            {
                Transform statsRoot = FindChildByName(transform, "Stats", "StatContainer", "Stat Item Container", "Content");
                statItemContainer = statsRoot != null ? statsRoot : transform;
            }
        }

        private void PopulateData()
        {
            if (currentArtifact == null) return;

            if (artifactIcon != null && currentArtifact.icon != null)
            {
                artifactIcon.sprite = currentArtifact.icon;
                artifactIcon.enabled = true;
            }

            if (artifactNameText != null)
            {
                artifactNameText.text = currentArtifact.itemName;
            }

            // Clear existing stat items
            if (statItemContainer != null)
            {
                foreach (Transform child in statItemContainer)
                {
                    Destroy(child.gameObject);
                }

                if (statItemPrefab != null && currentArtifact.bonusStats != null)
                {
                    AddStatItemIfNonZero("HP", currentArtifact.bonusStats.maxHP, "hp");
                    AddStatItemIfNonZero("ATK", currentArtifact.bonusStats.attack, "atk");
                    AddStatItemIfNonZero("DEF", currentArtifact.bonusStats.defense, "def");
                    AddStatItemIfNonZero("SPD", currentArtifact.bonusStats.speed, "spd");
                    AddStatItemIfNonZero("Crit Rate", currentArtifact.bonusStats.critRate, "crit");
                    AddStatItemIfNonZero("Crit DMG", currentArtifact.bonusStats.critDamage, "crit");
                    AddStatItemIfNonZero("Cooldown Rate", currentArtifact.bonusStats.cooldownRate, "cdr");
                    AddStatItemIfNonZero("Elemental Mastery", currentArtifact.bonusStats.elementalMastery, "elemental");
                    AddStatItemIfNonZero("Impact", currentArtifact.bonusStats.impact, "impact");
                    AddStatItemIfNonZero("AE Recharge", currentArtifact.bonusStats.aeRecharge * 100f, "ae");
                }
            }

            if (descriptionText != null)
            {
                descriptionText.text = currentArtifact.passiveDescription;
            }

            if (loreText != null)
            {
                loreText.text = currentArtifact.description;
            }
        }

        private void AddStatItemIfNonZero(string statName, float value, string statKey = "")
        {
            if (Mathf.Abs(value) > 0.001f)
            {
                if (statItemPrefab == null || statItemContainer == null)
                {
                    return;
                }

                GameObject obj = Instantiate(statItemPrefab, statItemContainer);
                StatItemUI ui = obj.GetComponent<StatItemUI>();
                if (ui != null)
                {
                    ui.Setup(statName, value, statKey);
                }
            }
        }

        private static TMP_Text FindTextByName(TMP_Text[] texts, params string[] names)
        {
            if (texts == null || names == null)
            {
                return null;
            }

            for (int i = 0; i < names.Length; i++)
            {
                for (int j = 0; j < texts.Length; j++)
                {
                    if (texts[j] != null && texts[j].name.IndexOf(names[i], System.StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        return texts[j];
                    }
                }
            }

            return null;
        }

        private static Image FindImageByName(Image[] images, params string[] names)
        {
            if (images == null || names == null)
            {
                return null;
            }

            for (int i = 0; i < names.Length; i++)
            {
                for (int j = 0; j < images.Length; j++)
                {
                    if (images[j] != null && images[j].name.IndexOf(names[i], System.StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        return images[j];
                    }
                }
            }

            return null;
        }

        private static Transform FindChildByName(Transform root, params string[] names)
        {
            if (root == null || names == null)
            {
                return null;
            }

            Transform[] children = root.GetComponentsInChildren<Transform>(true);
            for (int i = 0; i < names.Length; i++)
            {
                for (int j = 0; j < children.Length; j++)
                {
                    if (children[j] != null && children[j].name.IndexOf(names[i], System.StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        return children[j];
                    }
                }
            }

            return null;
        }
    }
}
