    {
        EffectDrawerUtility.Draw(ref position, Prop(property, "trigger"));
        EffectDrawerUtility.Draw(ref position, Prop(property, "filter"));
        EffectDrawerUtility.Draw(ref position, Prop(property, "requiredTags"));
